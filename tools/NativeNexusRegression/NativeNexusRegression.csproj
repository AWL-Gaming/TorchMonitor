<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net48</TargetFramework><LangVersion>8</LangVersion>
    <PlatformTarget>x64</PlatformTarget><Prefer32Bit>false</Prefer32Bit>
    <NativeRoot Condition="'$(NativeRoot)' == ''">$(MSBuildThisFileDirectory)..\..</NativeRoot>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="TorchMonitor"><HintPath>$(NativeRoot)\TorchMonitor\bin\Release\TorchMonitor.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="VRage.Math"><HintPath>$(NativeRoot)\GameBinaries\VRage.Math.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Sandbox.Game"><HintPath>$(NativeRoot)\GameBinaries\Sandbox.Game.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
